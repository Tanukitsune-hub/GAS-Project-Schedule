{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gas-project-schedule:stage-a-direct-verification:v1",
  "title": "Synthetic Stage A0 direct-verification contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "evidence"],
  "properties": {
    "schema_id": { "const": "GAS_STAGE_A_DIRECT_VERIFICATION_V1" },
    "evidence": { "$ref": "#/$defs/stageA0Evidence" }
  },
  "$defs": {
    "evidenceStatus": {
      "enum": [
        "DIRECTLY_VERIFIED",
        "LOCALLY_ATTESTED",
        "INFERRED",
        "UNKNOWN_NOT_EXPOSED",
        "CONTRADICTED"
      ]
    },
    "stageA0Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_personal_synthetic_non_company",
        "target_intended_bound_sandbox",
        "automation_off",
        "test_mode_true_where_applicable",
        "oauth_client_standard_cloud_project_equality",
        "apps_script_api_project_enablement",
        "oauth_audience_client_equality",
        "required_scope_coverage",
        "token_validity_threshold",
        "oauth_principal_myself_identity_equality",
        "immutable_api_executable_deployment_binding",
        "execution_target_is_api_executable_deployment_id",
        "execution_api_target_semantics",
        "function_and_version_lineage",
        "script_project_ownership_evidence",
        "bound_container_ownership_evidence",
        "cross_domain_transfer_shared_drive_absent",
        "prior_attempt_markers_preserved"
      ],
      "properties": {
        "target_personal_synthetic_non_company": { "$ref": "#/$defs/evidenceStatus" },
        "target_intended_bound_sandbox": { "$ref": "#/$defs/evidenceStatus" },
        "automation_off": { "$ref": "#/$defs/evidenceStatus" },
        "test_mode_true_where_applicable": { "$ref": "#/$defs/evidenceStatus" },
        "oauth_client_standard_cloud_project_equality": { "$ref": "#/$defs/evidenceStatus" },
        "apps_script_api_project_enablement": { "$ref": "#/$defs/evidenceStatus" },
        "oauth_audience_client_equality": { "$ref": "#/$defs/evidenceStatus" },
        "required_scope_coverage": { "$ref": "#/$defs/evidenceStatus" },
        "token_validity_threshold": { "$ref": "#/$defs/evidenceStatus" },
        "oauth_principal_myself_identity_equality": { "$ref": "#/$defs/evidenceStatus" },
        "immutable_api_executable_deployment_binding": { "$ref": "#/$defs/evidenceStatus" },
        "execution_target_is_api_executable_deployment_id": { "$ref": "#/$defs/evidenceStatus" },
        "execution_api_target_semantics": { "$ref": "#/$defs/evidenceStatus" },
        "function_and_version_lineage": { "$ref": "#/$defs/evidenceStatus" },
        "script_project_ownership_evidence": { "$ref": "#/$defs/evidenceStatus" },
        "bound_container_ownership_evidence": { "$ref": "#/$defs/evidenceStatus" },
        "cross_domain_transfer_shared_drive_absent": { "$ref": "#/$defs/evidenceStatus" },
        "prior_attempt_markers_preserved": { "$ref": "#/$defs/evidenceStatus" }
      }
    },
    "safeDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "outcome",
        "status_counts",
        "scripts_run",
        "clasp_run_function",
        "remote_call_performed",
        "target_mutation_performed",
        "probe_staging",
        "deployment_creation",
        "stage_b_attempt",
        "function_invocation"
      ],
      "properties": {
        "contract_version": { "const": "GAS_STAGE_A_DIRECT_VERIFICATION_V1" },
        "outcome": {
          "enum": [
            "STAGE_A0_DIRECT_VERIFICATION_PASS",
            "STAGE_A_BLOCKED_NEEDS_OPERATOR_OR_PLATFORM_EVIDENCE",
            "STAGE_A_FAILED_CLOSED"
          ]
        },
        "status_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "DIRECTLY_VERIFIED",
            "LOCALLY_ATTESTED",
            "INFERRED",
            "UNKNOWN_NOT_EXPOSED",
            "CONTRADICTED"
          ],
          "properties": {
            "DIRECTLY_VERIFIED": { "type": "integer", "minimum": 0 },
            "LOCALLY_ATTESTED": { "type": "integer", "minimum": 0 },
            "INFERRED": { "type": "integer", "minimum": 0 },
            "UNKNOWN_NOT_EXPOSED": { "type": "integer", "minimum": 0 },
            "CONTRADICTED": { "type": "integer", "minimum": 0 }
          }
        },
        "scripts_run": { "const": "NOT_EXECUTED" },
        "clasp_run_function": { "const": "NOT_EXECUTED" },
        "remote_call_performed": { "const": false },
        "target_mutation_performed": { "const": false },
        "probe_staging": { "const": "NOT_EXECUTED" },
        "deployment_creation": { "const": "NOT_EXECUTED" },
        "stage_b_attempt": { "const": "NOT_STARTED" },
        "function_invocation": { "const": "NOT_EXECUTED" }
      }
    }
  }
}
