/**
 * Quick and explicit Deep Diagnostic through Phase 7. All checks are read-only.
 */
var WorkOsDiagnostics = (function () {
  function check(id, status, safeMessage, details) {
    return {
      id: id,
      status: status,
      safe_message: safeMessage || '',
      details: details || {}
