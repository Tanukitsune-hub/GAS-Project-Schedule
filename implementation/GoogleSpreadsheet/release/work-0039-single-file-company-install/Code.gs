    };
    requireReady(value.test_mode === false, 'TEST_MODE_ENABLED');
    requireReady(prerequisites.ready === true,
      'AUTOMATION_PREREQUISITES_INCOMPLETE');
    requireReady(details.candidate.ready === true,
