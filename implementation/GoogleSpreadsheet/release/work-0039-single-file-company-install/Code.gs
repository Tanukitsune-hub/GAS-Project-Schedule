      claim_run_id: '',
      preprocess_hash: '',
      classification_json: '',
      classification_hash: '',
      action_count: 0,
      retry_count: 0,
      next_retry_at: '',
      completed_at: '',
      last_error_code: '',
      last_error_at: '',
      schema_version: WorkOsConfig.SCHEMA_VERSION,
      updated_at: timestamp,
