{
  "name": "gas-project-schedule-local-validation",
  "version": "2.8.12-local-validation.0",
  "private": true,
  "description": "Non-Google validation and guarded personal-dev clasp tooling for GAS Project Schedule.",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "verify": "node tools/local_validation_gate.js --mode local",
    "verify:local": "node tools/local_validation_gate.js --mode local",
    "verify:ci": "node tools/local_validation_gate.js --mode ci",
    "verify:json": "node tools/local_validation_gate.js --section json",
    "verify:yaml": "node tools/local_validation_gate.js --section yaml",
    "verify:apps-script": "node tools/local_validation_gate.js --section apps-script",
    "verify:tests": "node tools/local_validation_gate.js --section tests",
    "verify:release": "node tools/local_validation_gate.js --section release",
    "verify:lineage": "node tools/local_validation_gate.js --section lineage",
    "verify:secret-scan": "node tools/local_validation_gate.js --section secret-scan",
    "gas:stage:dev": "node tools/local_clasp_dev.js stage",
    "gas:auth-preflight:dev": "node tools/work_0004_target_bootstrap.js auth-preflight",
    "gas:create-synthetic:dev": "node tools/work_0004_target_bootstrap.js create-synthetic",
    "gas:inspect-synthetic:dev": "node tools/work_0004_target_bootstrap.js inspect-synthetic",
    "gas:push:dev": "node tools/local_clasp_dev.js push",
    "gas:pull-verify:dev": "node tools/local_clasp_dev.js pull-verify"
  },
  "devDependencies": {
    "@google/clasp": "3.3.0",
    "yaml": "2.9.0"
  }
}
